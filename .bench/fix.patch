+    tokio::time::advance(Duration::from_secs(5)).await;
+    assert!(heard.silent() >= Duration::from_secs(5));
+    theirs.write_all(b"x").await.unwrap();
+    let mut byte = [0u8; 1];
+    ours.read_exact(&mut byte).await.unwrap();
+    assert_eq!(heard.silent(), Duration::ZERO);
